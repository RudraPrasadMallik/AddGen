{
  "name": "addrgen",
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true
  },
  // SPA routing: any unknown path serves index.html so client-side routes
  // (e.g. /temp-address) and page refreshes work. This replaces the older
  // Pages-style public/_redirects file, which conflicts on the Workers path.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
